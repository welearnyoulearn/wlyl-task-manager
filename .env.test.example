# Copy this file to .env.test (gitignored) and fill in dedicated E2E test
# accounts created via Manage Members / Manage Admins in the live app.
# NEVER use real team member accounts here — tests create/accept/delete
# tasks and weekly updates under these credentials.
#
# If a username or password contains a space or a # character, wrap the
# whole value in double quotes — dotenv treats an unquoted # as a comment
# marker and silently truncates everything after it.

E2E_MEMBER_USERNAME=e2e-test-member
E2E_MEMBER_PASSWORD=

E2E_ADMIN_USERNAME=e2e-test-admin
E2E_ADMIN_PASSWORD=

# Phase 4: dedicated single-role accounts for member_role negative-path
# tests (tests/e2e/member-roles.spec.js). Create via Manage Members with
# Role set to Tester / Developer respectively — needed because
# E2E_MEMBER above has member_role='both', which passes every role gate
# and so can't exercise the "wrong role is rejected" path.
E2E_TESTER_USERNAME=e2e-test-tester
E2E_TESTER_PASSWORD=

E2E_DEVELOPER_USERNAME=e2e-test-developer
E2E_DEVELOPER_PASSWORD=
